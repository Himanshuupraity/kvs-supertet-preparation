# ---- Server ----
PORT=8787
CORS_ORIGIN=http://localhost:5173

# ---- AI provider (never expose these to the frontend) ----
# anthropic | openai-compatible | none
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# For OpenAI-compatible providers (OpenAI, Azure, Groq, local Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Admin ----
# Bearer token required for POST/PUT/DELETE on /api/content/* and for /api/jobs/*
ADMIN_TOKEN=change-me

# ---- Daily refresh job ----
# News sources for current-affairs research (see jobs/dailyRefresh.ts). Leave both empty to skip fetching.
# Option A (no key): comma-separated RSS/Atom feeds.
NEWS_FEEDS=https://www.pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3&reg=48,https://www.thehindu.com/news/national/feeder/default.rss
# Option B: a JSON news API returning {articles:[{title,description,url,source:{name},publishedAt}]}.
NEWS_API_KEY=
NEWS_API_URL=
# Where the job writes: server (server/data/*.json) or bundled (src/data/** — commit + redeploy; used by GitHub Actions)
PUBLISH_TO=server
DAILY_CA_MAX=8
DAILY_MCQ_COUNT=10

# ---- Database (optional; if unset the server stores content in server/data/*.json) ----
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
