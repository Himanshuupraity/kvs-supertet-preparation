# ---- Server ----
PORT=8787
CORS_ORIGIN=http://localhost:5173

# ---- AI provider (never expose these to the frontend) ----
# anthropic | openai-compatible | none
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# For OpenAI-compatible providers (OpenAI, Azure, Groq, local Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Admin ----
# Bearer token required for POST/PUT/DELETE on /api/content/* and for /api/jobs/*
ADMIN_TOKEN=change-me

# ---- Daily refresh job ----
# Optional news API for current-affairs research (see jobs/dailyRefresh.ts). Leave empty to skip fetching.
NEWS_API_KEY=
NEWS_API_URL=

# ---- Database (optional; if unset the server stores content in server/data/*.json) ----
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
