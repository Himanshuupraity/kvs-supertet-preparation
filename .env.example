# Frontend env (Vite). Only non-secret values belong here — never put API keys in the frontend.
# Base URL of the backend API. In dev, Vite proxies /api to http://localhost:8787 (see vite.config.ts).
VITE_API_BASE_URL=/api
# Set to "false" to hide AI features entirely and always use the offline rubric.
VITE_AI_ENABLED=auto
# Optional PIN to gate the Admin page in the browser (not a security boundary; the server ADMIN_TOKEN is).
VITE_ADMIN_PIN=
